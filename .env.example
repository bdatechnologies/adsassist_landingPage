# Public site URL (used for canonical links, sitemap and social cards)
NEXT_PUBLIC_SITE_URL=https://adsassist.in
# The product app (Log in button)
NEXT_PUBLIC_APP_URL=https://app.adsassist.in
# Where "Book a demo" requests are sent: an AdsAssist incoming webhook URL
# (app → Incoming webhooks → New source). Server-side only, never shown to visitors.
# Leave empty and the form falls back to opening an email to office@bda.co.in.
DEMO_WEBHOOK_URL=
